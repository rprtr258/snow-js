{
  "compilerOptions": {
    // Environment setup & latest features
    // WebWorker + DOM.Iterable cover dust's export-frame worker and iterators;
    // types: ["bun"] covers dust/scripts, which run under bun.
    "lib": ["DOM", "DOM.Iterable", "ESNext", "WebWorker"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "alwaysStrict": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // false so esbuild/vite (which resolve this tsconfig for dust/ files too)
    // elides type-only imports; dust's ported sources import types unmarked.
    "verbatimModuleSyntax": false,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // Build output only; dust/src and dust/scripts are type-checked here.
  "exclude": ["dust/dist"]
}
