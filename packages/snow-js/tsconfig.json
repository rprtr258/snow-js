{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["DOM", "DOM.Iterable", "ESNext", "WebWorker"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": false,
    "alwaysStrict": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // false so esbuild/vite (which resolve this tsconfig for noita/ files too)
    // elides type-only imports; noita's ported sources import types unmarked.
    "verbatimModuleSyntax": false,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true
  },
  // Build output only; effects/noita/src and effects/noita/scripts are
  // type-checked here.
  "exclude": ["effects/noita/dist"]
}
