{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // bun test files and the manually run wasm build tool (scripts/*.ts) plus
  // noita's script entry points are entries. The package.json exports
  // (index.ts) is an entry point as well. Nested */src/*.test.ts are covered
  // by knip's built-in test plugin patterns, so only the root-level test glob
  // is listed.
  "entry": [
    "scripts/*.ts",
    "noita/scripts/*.ts",
    "*.test.ts"
  ]
}
