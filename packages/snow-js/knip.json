{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // bun test files and the manually run effects/noita/scripts/*.ts tools are
  // entry points. The package.json exports (index.ts) is an entry point as
  // well.
  "entry": [
    "effects/noita/src/*.test.ts",
    "effects/noita/scripts/*.ts",
    "*.test.ts"
  ],
  "project": ["*.ts", "effects/**/*.ts"]
}
