{
  "name": "snow-js",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./dust/src/embed.ts": {
      "types": "./dust/src/embed.d.ts",
      "default": "./dust/src/embed.ts"
    }
  },
  "scripts": {
    "dev:website": "bun run dev --filter=./website",
    "lint": "eslint '**/*.{ts,json}' && tsc -p tsconfig.json && tsc -p tsconfig.dust.json && knip",
    "lint:fix": "eslint '**/*.{ts,json}' --fix",
    "test": "bun test",
    "build:dust": "cd dust && bun run scripts/build.ts",
    "dev:dust": "cd dust && bun run scripts/dev.ts",
    "serve:dust": "cd dust && bun run scripts/serve.ts"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "knip": "^6.44.2"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.52.0"
  }
}