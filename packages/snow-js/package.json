{
  "name": "snow-js",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "dev:website": "bun run dev --filter=./website",
    "lint": "eslint '**/*.{ts,json}' && knip",
    "typecheck": "bun check",
    "lint:fix": "eslint '**/*.{ts,json}' --fix",
    "test": "bun test",
    "build:dust": "cd effects/dust && bun run scripts/build.ts",
    "dev:dust": "cd effects/dust && bun run scripts/dev.ts",
    "serve:dust": "cd effects/dust && bun run scripts/serve.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "knip": "^6.44.2"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.52.0"
  }
}